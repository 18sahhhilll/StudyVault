# LLM Answer Generation Configuration
# Select provider: 'gemini' or 'openai'
LLM_PROVIDER=gemini

# Model names:
# For Gemini: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
# For OpenAI: gpt-4o, gpt-4o-mini
LLM_MODEL=gemini-1.5-flash

# API Keys (Keep secure! Never commit to git or expose in frontend code)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
